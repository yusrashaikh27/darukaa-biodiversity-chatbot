# LLM provider for the reasoning node: "groq" (default) or "anthropic"
LLM_PROVIDER=groq

# Groq (used when LLM_PROVIDER=groq) — get a free key at console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://darukaa:darukaa@localhost:5432/darukaa

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
